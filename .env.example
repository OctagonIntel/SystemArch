# Copy to .env and fill in. .env is git-ignored — never commit it.
#
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler".
# Use the SESSION pooler (port 5432), not the transaction pooler (6543):
#   - session mode keeps SET ROLE / session variables working (needed for RLS, ADR-006)
#   - the direct connection is IPv6-only on the free tier
#
# Admin connection: used ONLY by `just apply-policy` to create roles and apply grants.
# Tests and ingest must NEVER use this — they connect as their own role.
# Host prefix may be aws-0- or aws-1-; copy it exactly from the dashboard.
ADMIN_DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres

# Pooler usernames are "<role>.<project_ref>". Kept separate so per-role URLs can be built.
DB_HOST=aws-N-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
SUPABASE_PROJECT_REF=<project_ref>

# Login passwords for service accounts and people are added by `just apply-policy`
# and `just rotate-creds` (ADR-012). You don't write them by hand.
