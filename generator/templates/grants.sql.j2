-- Generated from policy/*.yaml. Don't edit.
-- Part 2, as {{ owner }}: revoke every grant in our schemas, from anyone, then grant
-- what the policy says. dbt-built tables are handled by governance.apply_access.

{% for schema in schemas.values() %}
COMMENT ON SCHEMA {{ schema.name }} IS {{ schema.description | sql_literal }};
{% endfor %}

DO $$
DECLARE r record;
BEGIN
  -- Schemas
  FOR r IN
    SELECT n.nspname AS obj, a.grantee
    FROM pg_namespace n, aclexplode(n.nspacl) a
    WHERE n.nspname IN ({% for s in schemas %}'{{ s }}'{{ ", " if not loop.last }}{% endfor %}) AND a.grantee <> n.nspowner
  LOOP
    EXECUTE format('REVOKE ALL ON SCHEMA %I FROM %s', r.obj,
      CASE r.grantee WHEN 0 THEN 'PUBLIC' ELSE quote_ident(pg_get_userbyid(r.grantee)) END);
  END LOOP;

  -- Tables and views we own. Column grants go with them.
  FOR r IN
    SELECT DISTINCT c.oid::regclass AS obj, a.grantee
    FROM pg_class c
    JOIN pg_namespace n ON n.oid = c.relnamespace
    CROSS JOIN LATERAL (
      SELECT x.grantee FROM aclexplode(c.relacl) x
      UNION SELECT x.grantee FROM pg_attribute att, aclexplode(att.attacl) x WHERE att.attrelid = c.oid
    ) a
    WHERE n.nspname IN ({% for s in schemas %}'{{ s }}'{{ ", " if not loop.last }}{% endfor %})
      AND c.relkind IN ('r', 'p', 'v', 'm', 'f')
      AND c.relowner = '{{ owner }}'::regrole AND a.grantee <> c.relowner
  LOOP
    EXECUTE format('REVOKE ALL ON %s FROM %s', r.obj,
      CASE r.grantee WHEN 0 THEN 'PUBLIC' ELSE quote_ident(pg_get_userbyid(r.grantee)) END);
  END LOOP;

  -- Functions
  FOR r IN
    SELECT p.oid::regprocedure AS obj, a.grantee
    FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace,
         aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) a
    WHERE n.nspname IN ({% for s in schemas %}'{{ s }}'{{ ", " if not loop.last }}{% endfor %}) AND a.grantee <> p.proowner
  LOOP
    EXECUTE format('REVOKE ALL ON FUNCTION %s FROM %s', r.obj,
      CASE r.grantee WHEN 0 THEN 'PUBLIC' ELSE quote_ident(pg_get_userbyid(r.grantee)) END);
  END LOOP;
END
$$;

{% for role in roles %}
-- {{ role.name }}: {{ role.purpose }}
{% for schema, privs in role.schema_grants.items() %}
GRANT {{ privs | join(", ") }} ON SCHEMA {{ schema }} TO {{ role.name }};
{% endfor %}
{% for g in role.table_grants if not schemas[g.schema].built_by %}
GRANT {{ g.privileges | join(", ") }} ON {{ (g.schema ~ "." ~ g.table) if g.table else ("ALL TABLES IN SCHEMA " ~ g.schema) }} TO {{ role.name }};
{% endfor %}
{% for fn, privs in role.function_grants.items() %}
GRANT {{ privs | join(", ") }} ON FUNCTION {{ fn }} TO {{ role.name }};
{% endfor %}

{% endfor %}
